# ==============================================================
# SysA+ - Variables de Entorno (Docker / Docker Compose)
# ==============================================================

# Contraseña del usuario 'sa' de SQL Server (requiere mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=SysAPlus2026!Secure

# Puerto de SQL Server expuesto en tu máquina (permite conectar DBeaver, Azure Data Studio, SSMS, etc.)
MSSQL_PORT=1433

# Puerto de la API Backend en tu máquina
BACKEND_PORT=3000

# Puerto de la aplicación Frontend en tu máquina (accesible en http://localhost:5173)
FRONTEND_PORT=5173

# Clave secreta para firma de sesiones / tokens JWT
JWT_SECRET=sysaplus_super_secret_jwt_key_2026!

# Cadena de conexión para Prisma (dentro de la red Docker se conecta al servicio 'sqlserver')
DATABASE_URL=sqlserver://sqlserver:1433;database=sysaplus;user=sa;password=SysAPlus2026!Secure;encrypt=true;trustServerCertificate=true;
# Procesos de Node que atienden la API (1 = sin cluster). El pool y los hilos son por proceso.
WEB_CONCURRENCY=1
# Pool de conexiones a SQL Server y espera máxima de una transacción por una conexión libre
DB_POOL_MAX=20
DB_TX_MAX_WAIT_MS=10000

# Configuración de sesiones y seguridad
NODE_ENV=production
SESSION_HOURS=8
REMEMBER_ME_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Límite de intentos fallidos por IP (independiente del bloqueo de cuenta)
LOGIN_IP_MAX_ATTEMPTS=3
LOGIN_IP_BLOCK_MINUTES=15
