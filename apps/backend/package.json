    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:frgp": "tsx prisma/seed-frgp.ts",
    "db:seed:demo-certificados": "tsx prisma/seed-demo-certificados.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "test:integration": "tsx --test tests/academic.integration.test.ts tests/studentCourses.integration.test.ts"
  },
