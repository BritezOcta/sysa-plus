generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model ACADEMIC_PERIOD {
  ACADEMIC_PERIOD_ID Int               @id(map: "PK_ACADEMIC_PERIOD") @default(autoincrement())
  YEAR               Int               @db.SmallInt
  SEMESTER           Int               @db.TinyInt
  PERIOD_START_DATE  DateTime          @db.Date
  PERIOD_END_DATE    DateTime          @db.Date
  COURSE_OFFERING    COURSE_OFFERING[]

  @@unique([YEAR, SEMESTER], map: "UQ_ACADEMIC_PERIOD")
}

model ADMINISTRATOR_PROFILE {
  ADMIN_ID Int   @id(map: "PK_ADMINISTRATOR_PROFILE") @default(autoincrement())
  USER_ID  Int   @unique(map: "UQ_ADMIN_USER")
  USERS    USERS @relation(fields: [USER_ID], references: [USER_ID], onUpdate: NoAction, map: "FK_ADMIN_USERS")
}

model ASSESSMENT_GRADE {
  ASSESSMENT_GRADE_ID  Int               @id(map: "PK_ASSESSMENT_GRADE") @default(autoincrement())
  ASSESSMENT_ID        Int
  COURSE_ENROLLMENT_ID Int
  GRADE_SCORE          Decimal           @db.Decimal(5, 2)
  ASSESSMENTS          ASSESSMENTS       @relation(fields: [ASSESSMENT_ID], references: [ASSESSMENT_ID], onUpdate: NoAction, map: "FK_AG_ASSESSMENT")
  COURSE_ENROLLMENT    COURSE_ENROLLMENT @relation(fields: [COURSE_ENROLLMENT_ID], references: [COURSE_ENROLLMENT_ID], onUpdate: NoAction, map: "FK_AG_ENROLLMENT")

  @@unique([ASSESSMENT_ID, COURSE_ENROLLMENT_ID], map: "UQ_ASSESSMENT_GRADE")
  @@index([COURSE_ENROLLMENT_ID], map: "IX_AG_ENROLLMENT")
}

model ASSESSMENTS {
  ASSESSMENT_ID      Int                @id(map: "PK_ASSESSMENTS") @default(autoincrement())
  COURSE_OFFERING_ID Int
  ASSESSMENT_DATE    DateTime?          @db.Date
  MAX_SCORE          Decimal            @db.Decimal(5, 2)
  ASSESSMENT_NAME    String             @db.NVarChar(150)
  ASSESSMENT_TYPE    String             @db.NVarChar(50)
  ASSESSMENT_GRADE   ASSESSMENT_GRADE[]
  COURSE_OFFERING    COURSE_OFFERING    @relation(fields: [COURSE_OFFERING_ID], references: [COURSE_OFFERING_ID], onUpdate: NoAction, map: "FK_ASSESS_OFFERING")

  @@index([COURSE_OFFERING_ID], map: "IX_ASSESS_OFFERING")
}

model ATTENDANCE {
  ATTENDANCE_ID        Int               @id(map: "PK_ATTENDANCE") @default(autoincrement())
  CLASS_SESSION_ID     Int
  COURSE_ENROLLMENT_ID Int
  ATTENDANCE_STATUS    String            @db.NVarChar(20)
  COURSE_ENROLLMENT    COURSE_ENROLLMENT @relation(fields: [COURSE_ENROLLMENT_ID], references: [COURSE_ENROLLMENT_ID], onUpdate: NoAction, map: "FK_ATT_ENROLLMENT")
  CLASS_SESSION        CLASS_SESSION     @relation(fields: [CLASS_SESSION_ID], references: [CLASS_SESSION_ID], onUpdate: NoAction, map: "FK_ATT_SESSION")

  @@unique([CLASS_SESSION_ID, COURSE_ENROLLMENT_ID], map: "UQ_ATTENDANCE")
}

model CAREERS {
  CAREER_ID      Int              @id(map: "PK_CAREERS") @default(autoincrement())
  CAREER_NAME    String           @db.NVarChar(150)
  CAREER_CODE    String           @unique(map: "UQ_CAREERS_CODE") @db.NVarChar(20)
  STUDENT_CAREER STUDENT_CAREER[]
  STUDY_PLAN     STUDY_PLAN[]
}

model CLASS_SESSION {
  CLASS_SESSION_ID   Int             @id(map: "PK_CLASS_SESSION") @default(autoincrement())
  COURSE_OFFERING_ID Int
  SESSION_DATE       DateTime        @db.Date
  SESSION_TOPIC      String?         @db.NVarChar(255)
  ATTENDANCE         ATTENDANCE[]
  COURSE_OFFERING    COURSE_OFFERING @relation(fields: [COURSE_OFFERING_ID], references: [COURSE_OFFERING_ID], onUpdate: NoAction, map: "FK_CS_OFFERING")

  @@index([COURSE_OFFERING_ID], map: "IX_CS_OFFERING")
}

model COURSE_ENROLLMENT {
  COURSE_ENROLLMENT_ID Int                @id(map: "PK_COURSE_ENROLLMENT") @default(autoincrement())
  STUDENT_CAREER_ID    Int
  COURSE_OFFERING_ID   Int
  ENROLLMENT_DATE      DateTime           @default(dbgenerated("CONVERT([date],getdate())"), map: "DF_CE_DATE") @db.Date
  ENROLLMENT_STATUS    String             @db.NVarChar(30)
  ASSESSMENT_GRADE     ASSESSMENT_GRADE[]
  ATTENDANCE           ATTENDANCE[]
  COURSE_OFFERING      COURSE_OFFERING    @relation(fields: [COURSE_OFFERING_ID], references: [COURSE_OFFERING_ID], onUpdate: NoAction, map: "FK_CE_OFFERING")
  STUDENT_CAREER       STUDENT_CAREER     @relation(fields: [STUDENT_CAREER_ID], references: [STUDENT_CAREER_ID], onUpdate: NoAction, map: "FK_CE_STUDENT_CAREER")

  @@unique([STUDENT_CAREER_ID, COURSE_OFFERING_ID], map: "UQ_COURSE_ENROLLMENT")
  @@index([COURSE_OFFERING_ID], map: "IX_CE_OFFERING")
}

model COURSE_OFFERING {
  COURSE_OFFERING_ID    Int                  @id(map: "PK_COURSE_OFFERING") @default(autoincrement())
  STUDY_PLAN_SUBJECT_ID Int
  ACADEMIC_PERIOD_ID    Int
  COMMISSION            String               @db.NVarChar(20)
  CAPACITY              Int
  OFFERING_STATUS       String               @db.NVarChar(30)
  ASSESSMENTS           ASSESSMENTS[]
  CLASS_SESSION         CLASS_SESSION[]
  COURSE_ENROLLMENT     COURSE_ENROLLMENT[]
  ACADEMIC_PERIOD       ACADEMIC_PERIOD      @relation(fields: [ACADEMIC_PERIOD_ID], references: [ACADEMIC_PERIOD_ID], onUpdate: NoAction, map: "FK_CO_PERIOD")
  STUDY_PLAN_SUBJECT    STUDY_PLAN_SUBJECT   @relation(fields: [STUDY_PLAN_SUBJECT_ID], references: [STUDY_PLAN_SUBJECT_ID], onUpdate: NoAction, map: "FK_CO_SPS")
  TEACHER_ASSIGNMENT    TEACHER_ASSIGNMENT[]

  @@unique([STUDY_PLAN_SUBJECT_ID, ACADEMIC_PERIOD_ID, COMMISSION], map: "UQ_COURSE_OFFERING")
  @@index([ACADEMIC_PERIOD_ID], map: "IX_CO_PERIOD")
}

model EXAM_CALL {
  EXAM_CALL_ID          Int                @id(map: "PK_EXAM_CALL") @default(autoincrement())
  STUDY_PLAN_SUBJECT_ID Int
  EXAM_SESSION_ID       Int
  CALL_DATE             DateTime
  CALL_STATUS           String             @db.NVarChar(30)
  EXAM_SESSION          EXAM_SESSION       @relation(fields: [EXAM_SESSION_ID], references: [EXAM_SESSION_ID], onUpdate: NoAction, map: "FK_EC_SESSION")
  STUDY_PLAN_SUBJECT    STUDY_PLAN_SUBJECT @relation(fields: [STUDY_PLAN_SUBJECT_ID], references: [STUDY_PLAN_SUBJECT_ID], onUpdate: NoAction, map: "FK_EC_SPS")
  EXAM_ENROLLMENT       EXAM_ENROLLMENT[]

  @@index([EXAM_SESSION_ID], map: "IX_EC_SESSION")
}

model EXAM_ENROLLMENT {
  EXAM_ENROLLMENT_ID    Int                @id(map: "PK_EXAM_ENROLLMENT") @default(autoincrement())
  EXAM_CALL_ID          Int
  STUDENT_CAREER_ID     Int
  STUDENT_STUDY_PLAN_ID Int
  EXAM_STATUS           String             @db.NVarChar(30)
  EXAM_GRADE            Decimal?           @db.Decimal(4, 2)
  EXAM_CALL             EXAM_CALL          @relation(fields: [EXAM_CALL_ID], references: [EXAM_CALL_ID], onUpdate: NoAction, map: "FK_EE_CALL")
  STUDENT_CAREER        STUDENT_CAREER     @relation(fields: [STUDENT_CAREER_ID], references: [STUDENT_CAREER_ID], onUpdate: NoAction, map: "FK_EE_STUDENT_CAREER")
  STUDENT_STUDY_PLAN    STUDENT_STUDY_PLAN @relation(fields: [STUDENT_STUDY_PLAN_ID], references: [STUDENT_STUDY_PLAN_ID], onUpdate: NoAction, map: "FK_EE_STUDENT_PLAN")

  @@unique([EXAM_CALL_ID, STUDENT_CAREER_ID], map: "UQ_EXAM_ENROLLMENT")
  @@index([STUDENT_CAREER_ID], map: "IX_EE_STUDENT_CAREER")
}

model EXAM_SESSION {
  EXAM_SESSION_ID    Int         @id(map: "PK_EXAM_SESSION") @default(autoincrement())
  EXAM_NAME          String      @db.NVarChar(100)
  EXAM_YEAR          Int         @db.SmallInt
  SESSION_START_DATE DateTime    @db.Date
  SESSION_END_DATE   DateTime    @db.Date
  SESSION_STATUS     String      @db.NVarChar(30)
  EXAM_CALL          EXAM_CALL[]
}

model STUDENT_CAREER {
  STUDENT_CAREER_ID  Int                  @id(map: "PK_STUDENT_CAREER") @default(autoincrement())
  STUDENT_ID         Int
  ADMISSION_YEAR     Int                  @db.SmallInt
  CAREER_ID          Int
  ACADEMIC_STATUS    String               @db.NVarChar(30)
  COURSE_ENROLLMENT  COURSE_ENROLLMENT[]
  EXAM_ENROLLMENT    EXAM_ENROLLMENT[]
  CAREERS            CAREERS              @relation(fields: [CAREER_ID], references: [CAREER_ID], onUpdate: NoAction, map: "FK_SC_CAREER")
  STUDENT_PROFILE    STUDENT_PROFILE      @relation(fields: [STUDENT_ID], references: [STUDENT_ID], onUpdate: NoAction, map: "FK_SC_STUDENT")
  STUDENT_STUDY_PLAN STUDENT_STUDY_PLAN[]

  @@unique([STUDENT_ID, CAREER_ID], map: "UQ_STUDENT_CAREER")
  @@index([CAREER_ID], map: "IX_SC_CAREER")
}

model STUDENT_PROFILE {
  STUDENT_ID     Int              @id(map: "PK_STUDENT_PROFILE") @default(autoincrement())
  LEGAJO         String           @unique(map: "UQ_STUDENT_LEGAJO") @db.NVarChar(20)
  USER_ID        Int              @unique(map: "UQ_STUDENT_USER")
  STUDENT_CAREER STUDENT_CAREER[]
  USERS          USERS            @relation(fields: [USER_ID], references: [USER_ID], onUpdate: NoAction, map: "FK_STUDENT_USERS")
}

model STUDENT_STUDY_PLAN {
  STUDENT_STUDY_PLAN_ID Int               @id(map: "PK_STUDENT_STUDY_PLAN") @default(autoincrement())
  STUDENT_CAREER_ID     Int
  STUDY_PLAN_ID         Int
  EXAM_ENROLLMENT       EXAM_ENROLLMENT[]
  STUDENT_CAREER        STUDENT_CAREER    @relation(fields: [STUDENT_CAREER_ID], references: [STUDENT_CAREER_ID], onUpdate: NoAction, map: "FK_SSP_STUDENT_CAREER")
  STUDY_PLAN            STUDY_PLAN        @relation(fields: [STUDY_PLAN_ID], references: [STUDY_PLAN_ID], onUpdate: NoAction, map: "FK_SSP_STUDY_PLAN")

  @@unique([STUDENT_CAREER_ID, STUDY_PLAN_ID], map: "UQ_STUDENT_STUDY_PLAN")
}

model STUDY_PLAN {
  STUDY_PLAN_ID      Int                  @id(map: "PK_STUDY_PLAN") @default(autoincrement())
  CAREER_ID          Int
  RESOLUTION         String               @db.NVarChar(100)
  IS_ACTIVE          Boolean              @default(true, map: "DF_STUDY_PLAN_ACTIVE")
  STUDENT_STUDY_PLAN STUDENT_STUDY_PLAN[]
  CAREERS            CAREERS              @relation(fields: [CAREER_ID], references: [CAREER_ID], onUpdate: NoAction, map: "FK_STUDY_PLAN_CAREERS")
  STUDY_PLAN_SUBJECT STUDY_PLAN_SUBJECT[]

  @@index([CAREER_ID], map: "IX_STUDY_PLAN_CAREER")
}

model STUDY_PLAN_SUBJECT {
  STUDY_PLAN_SUBJECT_ID                                                               Int                     @id(map: "PK_STUDY_PLAN_SUBJECT") @default(autoincrement())
  STUDY_PLAN_ID                                                                       Int
  SUBJECT_ID                                                                          Int
  SUBJECT_YEAR                                                                        Int                     @db.TinyInt
  SEMESTER                                                                            Int?                    @db.TinyInt
  WEEKLY_HOURS                                                                        Int?
  TOTAL_HOURS                                                                         Int?
  COURSE_OFFERING                                                                     COURSE_OFFERING[]
  EXAM_CALL                                                                           EXAM_CALL[]
  STUDY_PLAN                                                                          STUDY_PLAN              @relation(fields: [STUDY_PLAN_ID], references: [STUDY_PLAN_ID], onUpdate: NoAction, map: "FK_SPS_STUDY_PLAN")
  SUBJECTS                                                                            SUBJECTS                @relation(fields: [SUBJECT_ID], references: [SUBJECT_ID], onUpdate: NoAction, map: "FK_SPS_SUBJECTS")
  SUBJECT_CORRELATIVITY_SUBJECT_CORRELATIVITY_REQUIRED_SUBJECT_IDToSTUDY_PLAN_SUBJECT SUBJECT_CORRELATIVITY[] @relation("SUBJECT_CORRELATIVITY_REQUIRED_SUBJECT_IDToSTUDY_PLAN_SUBJECT")
  SUBJECT_CORRELATIVITY_SUBJECT_CORRELATIVITY_TARGET_SUBJECT_IDToSTUDY_PLAN_SUBJECT   SUBJECT_CORRELATIVITY[] @relation("SUBJECT_CORRELATIVITY_TARGET_SUBJECT_IDToSTUDY_PLAN_SUBJECT")

  @@unique([STUDY_PLAN_ID, SUBJECT_ID], map: "UQ_STUDY_PLAN_SUBJECT")
  @@index([SUBJECT_ID], map: "IX_SPS_SUBJECT")
}

model SUBJECT_CORRELATIVITY {
  CORRELATIVITY_ID                                                                 Int                @id(map: "PK_SUBJECT_CORRELATIVITY") @default(autoincrement())
  TARGET_SUBJECT_ID                                                                Int
  REQUIRED_SUBJECT_ID                                                              Int
  STUDY_PLAN_SUBJECT_SUBJECT_CORRELATIVITY_REQUIRED_SUBJECT_IDToSTUDY_PLAN_SUBJECT STUDY_PLAN_SUBJECT @relation("SUBJECT_CORRELATIVITY_REQUIRED_SUBJECT_IDToSTUDY_PLAN_SUBJECT", fields: [REQUIRED_SUBJECT_ID], references: [STUDY_PLAN_SUBJECT_ID], onUpdate: NoAction, map: "FK_CORR_REQUIRED")
  STUDY_PLAN_SUBJECT_SUBJECT_CORRELATIVITY_TARGET_SUBJECT_IDToSTUDY_PLAN_SUBJECT   STUDY_PLAN_SUBJECT @relation("SUBJECT_CORRELATIVITY_TARGET_SUBJECT_IDToSTUDY_PLAN_SUBJECT", fields: [TARGET_SUBJECT_ID], references: [STUDY_PLAN_SUBJECT_ID], onUpdate: NoAction, map: "FK_CORR_TARGET")

  @@unique([TARGET_SUBJECT_ID, REQUIRED_SUBJECT_ID], map: "UQ_CORRELATIVITY")
}

model SUBJECTS {
  SUBJECT_ID          Int                  @id(map: "PK_SUBJECTS") @default(autoincrement())
  SUBJECT_CODE        String               @unique(map: "UQ_SUBJECTS_CODE") @db.NVarChar(20)
  SUBJECT_NAME        String               @db.NVarChar(150)
  SUBJECT_DESCRIPTION String?              @db.NVarChar(500)
  STUDY_PLAN_SUBJECT  STUDY_PLAN_SUBJECT[]
}

model TEACHER_ASSIGNMENT {
  TEACHER_ASSIGNMENT_ID Int             @id(map: "PK_TEACHER_ASSIGNMENT") @default(autoincrement())
  TEACHER_ID            Int
  COURSE_OFFERING_ID    Int
  COURSE_OFFERING       COURSE_OFFERING @relation(fields: [COURSE_OFFERING_ID], references: [COURSE_OFFERING_ID], onUpdate: NoAction, map: "FK_TA_OFFERING")
  TEACHER_PROFILE       TEACHER_PROFILE @relation(fields: [TEACHER_ID], references: [TEACHER_ID], onUpdate: NoAction, map: "FK_TA_TEACHER")

  @@unique([TEACHER_ID, COURSE_OFFERING_ID], map: "UQ_TEACHER_ASSIGNMENT")
}

model TEACHER_PROFILE {
  TEACHER_ID         Int                  @id(map: "PK_TEACHER_PROFILE") @default(autoincrement())
  USER_ID            Int                  @unique(map: "UQ_TEACHER_USER")
  TEACHER_ASSIGNMENT TEACHER_ASSIGNMENT[]
  USERS              USERS                @relation(fields: [USER_ID], references: [USER_ID], onUpdate: NoAction, map: "FK_TEACHER_USERS")
}

model USERS {
  USER_ID               Int                    @id(map: "PK_USERS") @default(autoincrement())
  ROLE                  String                 @db.NVarChar(30)
  DNI                   String                 @unique(map: "UQ_USERS_DNI") @db.NVarChar(20)
  PASSWORD_HASH         String                 @db.NVarChar(255)
  FIRST_NAME            String                 @db.NVarChar(100)
  LAST_NAME             String                 @db.NVarChar(100)
  EMAIL                 String                 @unique(map: "UQ_USERS_EMAIL") @db.NVarChar(255)
  ADMINISTRATOR_PROFILE ADMINISTRATOR_PROFILE?
  STUDENT_PROFILE       STUDENT_PROFILE?
  TEACHER_PROFILE       TEACHER_PROFILE?

  @@index([ROLE], map: "IX_USERS_ROLE")
}
